"""
JSON数据生成器

提供JSON格式数据的生成，支持JSON Schema验证、复杂嵌套结构和数据类型约束。
"""

import json
import random
from datetime import date, datetime
from typing import Any, Optional

from dataforge.core.generator import DataGenerator, GeneratorConfig

from ...core.types import GeneratorType


class JSONGenerator(DataGenerator):
    """JSON数据生成器基类"""

    def __init__(self, config: GeneratorConfig):
        super().__init__(config)
        self.schema = self.config.parameters.get("schema", {})
        self.depth = self.config.parameters.get("depth", 3)
        self.array_size = self.config.parameters.get("array_size", (1, 5))
        self.use_null = self.config.parameters.get("use_null", True)
        self.key_length = self.config.parameters.get("key_length", (3, 10))

    def _generate_primitive(self, type_hint: Optional[str] = None) -> Any:
        """生成原始类型数据"""
        type_map = {
            "string": lambda: self._generate_string(),
            "number": lambda: random.uniform(0, 1000),
            "integer": lambda: random.randint(0, 1000),
            "boolean": lambda: random.choice([True, False]),
            "null": lambda: None,
            "datetime": lambda: datetime.now().isoformat(),
            "date": lambda: date.today().isoformat(),
            "email": lambda: f"user{random.randint(1000, 9999)}@example.com",
            "url": lambda: f"https://example{random.randint(1, 100)}.com",
            "ipv4": lambda: f"{random.randint(1, 255)}.{random.randint(1, 255)}.{random.randint(1, 255)}.{random.randint(1, 255)}",
        }

        if type_hint and type_hint in type_map:
            return type_map[type_hint]()

        # 随机选择类型
        available_types = ["string", "number", "integer", "boolean"]
        if self.use_null:
            available_types.append("null")

        selected_type = random.choice(available_types)
        return type_map[selected_type]()

    def _generate_string(self, min_len: Optional[int] = None, max_len: Optional[int] = None) -> str:
        """生成随机字符串"""
        if min_len is None:
            min_len = self.key_length[0] if isinstance(self.key_length, tuple) else 3
        if max_len is None:
            max_len = self.key_length[1] if isinstance(self.key_length, tuple) else 10

        length = random.randint(min_len, max_len)
        chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        return ''.join(random.choice(chars) for _ in range(length))

    def _generate_object(self, depth: int = 0) -> dict[str, Any]:
        """生成JSON对象"""
        if depth >= self.depth:
            return {}

        obj = {}
        num_keys = random.randint(1, 5)

        for _ in range(num_keys):
            key = self._generate_string(3, 15)
            value = self._generate_value(depth + 1)
            obj[key] = value

        return obj

    def _generate_array(self, depth: int = 0) -> list[Any]:
        """生成JSON数组"""
        if depth >= self.depth:
            return []

        min_size, max_size = self.array_size if isinstance(self.array_size, tuple) else (1, self.array_size)
        size = random.randint(min_size, max_size)

        return [self._generate_value(depth + 1) for _ in range(size)]

    def _generate_value(self, depth: int = 0) -> Any:
        """生成任意JSON值"""
        if depth >= self.depth:
            return self._generate_primitive()

        value_types = ["primitive", "object", "array"]
        if depth < self.depth - 1:  # 只在较浅层级生成复杂结构
            value_type = random.choice(value_types)
        else:
            value_type = "primitive"

        if value_type == "primitive":
            return self._generate_primitive()
        elif value_type == "object":
            return self._generate_object(depth)
        else:
            return self._generate_array(depth)

    def generate_single(self, context: Optional[dict[str, Any]] = None) -> str:
        """生成单个JSON字符串"""
        if self.schema:
            data = self._generate_from_schema(self.schema)
        else:
            data = self._generate_object()

        return json.dumps(data, ensure_ascii=False, indent=2)

    def _generate_from_schema(self, schema: dict[str, Any]) -> Any:
        """根据JSON Schema生成数据"""
        schema_type = schema.get("type", "object")

        if schema_type == "object":
            properties = schema.get("properties", {})
            required = schema.get("required", [])
            obj = {}

            for prop_name, prop_schema in properties.items():
                if prop_name in required or random.random() > 0.3:  # 70%概率生成可选字段
                    obj[prop_name] = self._generate_from_schema(prop_schema)

            return obj

        elif schema_type == "array":
            items_schema = schema.get("items", {})
            min_items = schema.get("minItems", 1)
            max_items = schema.get("maxItems", 5)

            count = random.randint(min_items, max_items)
            return [self._generate_from_schema(items_schema) for _ in range(count)]

        elif schema_type == "string":
            min_len = schema.get("minLength", 1)
            max_len = schema.get("maxLength", 50)
            pattern = schema.get("pattern")

            if pattern:
                # 简化模式匹配，实际应用中需要更复杂的实现
                return self._generate_string(min_len, max_len)
            else:
                return self._generate_string(min_len, max_len)

        elif schema_type == "number":
            minimum = schema.get("minimum", 0)
            maximum = schema.get("maximum", 1000)
            multiple_of = schema.get("multipleOf")

            value = random.uniform(minimum, maximum)
            if multiple_of:
                value = round(value / multiple_of) * multiple_of
            return value

        elif schema_type == "integer":
            minimum = schema.get("minimum", 0)
            maximum = schema.get("maximum", 1000)
            value = random.randint(int(minimum), int(maximum))

            multiple_of = schema.get("multipleOf")
            if multiple_of:
                value = (value // multiple_of) * multiple_of
            return value

        elif schema_type == "boolean":
            return random.choice([True, False])

        else:
            return self._generate_primitive()

    def validate(self, value: str) -> bool:
        """验证JSON格式"""
        try:
            json.loads(value)
            return True
        except (json.JSONDecodeError, TypeError):
            return False

    def generate_batch(self, count: int) -> list[str]:
        """批量生成JSON数据"""
        return [self.generate_single() for _ in range(count)]



    @property
    def generator_type(self) -> GeneratorType:
        """返回生成器类型"""
        return GeneratorType.ADVANCED

    @property
    def supported_parameters(self) -> list[str]:
        """返回支持的参数列表"""
        return []
class GenericJSONGenerator(JSONGenerator):
    """通用JSON数据生成器"""

    def __init__(self, config: GeneratorConfig):
        super().__init__(config)
        self._setup()

    def _setup(self) -> None:
        """初始化设置"""
        self.depth = self.config.parameters.get("depth", 3)
        self.array_size = self.config.parameters.get("array_size", (1, 5))
        self.use_null = self.config.parameters.get("use_null", True)
        self.template = self.config.parameters.get("template")

    def _generate_raw(self, context=None) -> str:
        """生成原始JSON字符串"""
        template = self.config.parameters.get("template")

        if template and template in self._get_json_templates():
            template_config = self._get_json_templates()[template]
            structure = template_config.get("structure", {})

            # 确保基本结构完整
            if not isinstance(structure, dict):
                structure = {"name": "default", "value": structure}

            # 确保包含name字段
            if "name" not in structure:
                structure["name"] = template_config.get("root_name", template)

            return json.dumps(structure, indent=2, ensure_ascii=False)
        else:
            return self._generate_json()

    def _generate_simple_text(self) -> str:
        """生成简单文本内容"""
        words = ["lorem", "ipsum", "dolor", "sit", "amet", "consectetur"]
        return " ".join(random.choices(words, k=3))

    def _generate_json(self) -> str:
        """生成默认JSON结构"""
        default_structure = {
            "name": "default",
            "type": "object",
            "properties": {
                "id": random.randint(1, 1000),
                "value": self._generate_simple_text()
            }
        }
        return json.dumps(default_structure, indent=2, ensure_ascii=False)

    def validate(self, data: str) -> bool:
        """验证JSON格式"""
        try:
            parsed = json.loads(data)
            return isinstance(parsed, (dict, list))
        except (json.JSONDecodeError, ValueError):
            return False

    @property
    def generator_type(self):
        """获取生成器类型"""
        return "structured"

    @property
    def supported_parameters(self) -> list[str]:
        """获取支持的参数列表"""
        return ["depth", "array_size", "use_null", "template"]

    def _get_json_templates(self) -> dict[str, dict[str, Any]]:
        """获取JSON模板配置"""
        return {
            "user": {
                "type": "object",
                "properties": {
                    "name": {"type": "string", "const": "test_user"},
                    "email": {"type": "string", "const": "test@example.com"},
                    "age": {"type": "integer", "const": 25},
                    "active": {"type": "boolean", "const": True}
                },
                "required": ["name", "email", "age", "active"]
            },
            "config": {
                "type": "object",
                "properties": {
                    "name": {"type": "string", "const": "app_config"},
                    "version": {"type": "string", "const": "1.0.0"},
                    "settings": {
                        "type": "object",
                        "properties": {
                            "debug": {"type": "boolean", "const": True},
                            "timeout": {"type": "integer", "const": 30}
                        }
                    }
                },
                "required": ["name", "version", "settings"]
            },
            "api": {
                "type": "object",
                "properties": {
                    "name": {"type": "string", "const": "api_response"},
                    "status": {"type": "string", "const": "success"},
                    "data": {
                        "type": "object",
                        "properties": {
                            "id": {"type": "integer", "const": 1},
                            "value": {"type": "string", "const": "test"}
                        }
                    }
                },
                "required": ["name", "status", "data"]
            }
        }

    def generate_single(self, context: Optional[dict[str, Any]] = None) -> str:
        """生成单个JSON数据"""
        template = self.config.parameters.get("template")
        if template:
            templates = self._get_json_templates()
            if template in templates:
                self.schema = templates[template]

        result = super().generate_single(context)

        # 根据格式参数调整输出
        format_type = self.config.parameters.get("format", "pretty")
        if format_type == "compact":
            data = json.loads(result)
            result = json.dumps(data, ensure_ascii=False, separators=(',', ':'))

        return result
