# DataForge 环境配置示例
# 复制此文件为 .env 并填写实际值

# ==========================================
# 环境模式
# ==========================================
# 设置为 false 启用生产模式安全检查
DEVELOPMENT=true

# ==========================================
# JWT 认证配置（生产环境必须设置）
# ==========================================
# 生成安全密钥: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# 示例: JWT_SECRET_KEY=your-generated-secret-key-here
JWT_SECRET_KEY=

# ==========================================
# CORS 配置（生产环境必须设置）
# ==========================================
# 允许的前端域名，多个域名用逗号分隔
# 示例: ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=

# ==========================================
# Redis 配置
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # 如果Redis设置了密码

# ==========================================
# API 配置
# ==========================================
# API_VERSION=1.0.0
# API_TITLE=DataForge API
# API_PORT=8000

# ==========================================
# 数据库配置（如果使用）
# ==========================================
# DATABASE_URL=postgresql://user:password@localhost/dataforge

# ==========================================
# 日志配置
# ==========================================
# LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FILE=  # 可选，不设置则仅输出到控制台

# ==========================================
# 生产环境安全提示
# ==========================================
# 1. 设置强JWT密钥（至少32字符）
# 2. 明确设置ALLOWED_ORIGINS，不使用通配符
# 3. 为Redis设置密码
# 4. 使用HTTPS协议
# 5. 定期更新依赖包
# 6. 启用日志记录
