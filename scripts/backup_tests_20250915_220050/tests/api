#!/usr/bin/env python3
"""
简单的API测试脚本
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from fastapi.testclient import TestClient

from dataforge.api.main import app


def test_api():
    """测试API功能"""
    print("=== DataForge API 功能测试 ===")

    # 创建测试客户端
    client = TestClient(app)

    # 1. 测试健康检查
    print("1. 健康检查:")
    response = client.get("/health")
    assert response.status_code == 200
    health_data = response.json()
    print(f"   状态: {health_data['status']}")
    print(f"   生成器数量: {health_data['generators_count']}")
    print()

    # 2. 测试生成器列表
    print("2. 生成器列表:")
    response = client.get("/generators")
    assert response.status_code == 200
    generators = response.json()
    print(f"   总数: {len(generators)}")
    print("   前5个:")
    for i, gen in enumerate(generators[:5]):
        print(f"     {i + 1}. {gen['name']} ({gen['type']})")
    print()

    # 3. 测试单个数据生成
    print("3. 单个数据生成:")
    payload = {
        "generator_type": "uuid",
        "count": 3,
        "parameters": {"version": 4},
        "validate": True,
        "output_format": "json",
    }

    response = client.post("/generate/uuid", json=payload)
    assert response.status_code == 200
    result = response.json()

    print(f"   成功: {result['success']}")
    print(f"   类型: {result['generator_type']}")
    print(f"   数量: {result['count']}")
    print("   数据:")
    for item in result["data"]:
        print(f"     - {item['uuid']}")
    print()

    # 4. 测试批量数据生成
    print("4. 批量数据生成:")
    payload = {
        "generators": [
            {"generator_type": "name", "parameters": {"gender": "FEMALE"}},
            {"generator_type": "email", "parameters": {"type": "COMMON"}},
            {"generator_type": "age", "parameters": {"min": 25, "max": 35}},
        ],
        "count": 2,
        "output_format": "json",
    }

    response = client.post("/batch/generate", json=payload)
    assert response.status_code == 200
    result = response.json()

    print(f"   成功: {result['success']}")
    print(f"   生成器: {result['generators']}")
    print(f"   记录数: {result['count']}")
    print("   数据:")
    for i, record in enumerate(result["data"]):
        print(
            f"     用户{i + 1}: {record['name']} | {record['email']} | 年龄{record['age']}"
        )
    print()

    # 5. 测试生成器信息
    print("5. 生成器详细信息:")
    response = client.get("/generators/email")
    assert response.status_code == 200
    info = response.json()

    print(f"   名称: {info['name']}")
    print(f"   类型: {info['type']}")
    print(f"   参数: {', '.join(info['parameters'])}")
    print(f"   示例参数: {info['example_parameters']}")
    print()

    # 6. 测试异步任务
    print("6. 异步任务:")
    payload = {
        "generator_type": "string",
        "count": 100,
        "parameters": {"length": 8, "charset": "ALPHANUMERIC"},
        "validate": True,
        "output_format": "json",
    }

    response = client.post("/generate/async/string", json=payload)
    assert response.status_code == 200
    task = response.json()

    print(f"   任务ID: {task['task_id']}")
    print(f"   状态: {task['status']}")
    print(f"   创建时间: {task['created_at']}")

    # 检查任务状态
    response = client.get(f"/tasks/{task['task_id']}")
    assert response.status_code == 200
    task_status = response.json()

    print(f"   当前状态: {task_status['status']}")
    print(f"   进度: {task_status['progress']}%")
    print()

    print("🎉 所有API测试通过！")


if __name__ == "__main__":
    test_api()
