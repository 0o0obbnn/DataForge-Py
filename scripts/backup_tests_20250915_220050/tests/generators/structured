class TestStructuredDataValidation:
    """结构化数据验证测试"""

    def test_json_validation(self):
        """测试JSON验证"""
        config = GeneratorConfig(
            generator_type="json",
            parameters={}
        )
        generator = GenericJSONGenerator(config)

        # 有效JSON
        valid_json = '{"name": "test", "value": 123}'
        assert generator.validate(valid_json)

        # 无效JSON
        invalid_json = '{"name": "test", "value": 123'
        assert not generator.validate(invalid_json)

    def test_xml_validation(self):
        """测试XML验证"""
        config = GeneratorConfig(
            generator_type="xml",
            parameters={}
        )
        generator = GenericXMLGenerator(config)

        # 有效XML
        valid_xml = '<root><item>test</item></root>'
        assert generator.validate(valid_xml)

        # 无效XML
        invalid_xml = '<root><item>test</item>'
        assert not generator.validate(invalid_xml)

    def test_yaml_validation(self):
        """测试YAML验证"""
        config = GeneratorConfig(
            generator_type="yaml",
            parameters={}
        )
        generator = GenericYAMLGenerator(config)

        # 有效YAML
        valid_yaml = 'name: test\nvalue: 123'
        assert generator.validate(valid_yaml)

        # 无效YAML
        invalid_yaml = 'name: test\n  value: 123'
        assert not generator.validate(invalid_yaml)


class TestStructuredDataIntegration:
    """结构化数据集成测试"""

    def test_cross_format_consistency(self):
        """测试跨格式一致性"""
        # 测试不同格式生成器都能正常工作
        configs = [
            GeneratorConfig(
                generator_type="json",
                parameters={"depth": 2}
            ),
            GeneratorConfig(
                generator_type="json",
                parameters={"template": "user"}
            ),
            GeneratorConfig(
                generator_type="json",
                parameters={"array_size": (2, 3)}
            )
        ]

        for config in configs:
            json_gen = GenericJSONGenerator(config)
            xml_gen = GenericXMLGenerator(config)
            yaml_gen = GenericYAMLGenerator(config)

            # 每个生成器都应该能生成有效数据
            json_data = json_gen.generate_single()
            xml_data = xml_gen.generate_single()
            yaml_data = yaml_gen.generate_single()

            assert json_gen.validate(json_data)
            assert xml_gen.validate(xml_data)
            assert yaml_gen.validate(yaml_data)

    def test_parameter_validation(self):
        """测试参数验证"""
        # 测试支持的参数
        json_gen = GenericJSONGenerator(GeneratorConfig(
            generator_type="json",
            parameters={}
        ))
        xml_gen = GenericXMLGenerator(GeneratorConfig(
            generator_type="xml",
            parameters={}
        ))
        yaml_gen = GenericYAMLGenerator(GeneratorConfig(
            generator_type="yaml",
            parameters={}
        ))

        assert isinstance(json_gen.supported_parameters, list)
        assert isinstance(xml_gen.supported_parameters, list)
        assert isinstance(yaml_gen.supported_parameters, list)

        # 参数列表不应为空
        assert len(json_gen.supported_parameters) > 0
        assert len(xml_gen.supported_parameters) > 0
        assert len(yaml_gen.supported_parameters) > 0


