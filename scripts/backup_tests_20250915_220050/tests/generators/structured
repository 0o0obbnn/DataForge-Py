"""
结构化数据生成器测试

测试JSON、XML、YAML生成器的功能和正确性。
"""

import json
import xml.etree.ElementTree as ET

import pytest
import yaml

from dataforge.core.generator import GeneratorConfig
from dataforge.generators.structured import (
    GenericJSONGenerator,
    GenericXMLGenerator,
    GenericYAMLGenerator,
)


class TestJSONGenerator:
    """JSON生成器测试"""

    def test_basic_json_generation(self):
        """测试基础JSON生成"""
        config = GeneratorConfig(
            generator_type="json",
            parameters={
                "depth": 3,
                "array_size": (1, 3),
                "use_null": True
            }
        )
        generator = GenericJSONGenerator(config)

        json_str = generator.generate_single()
        parsed = json.loads(json_str)

        assert isinstance(parsed, dict)
        assert generator.validate(json_str)

    def test_json_schema_validation(self):
        """测试JSON Schema验证"""
        config = GeneratorConfig(
            generator_type="json",
            parameters={
                "template": "user",
                "depth": 2
            }
        )
        generator = GenericJSONGenerator(config)

        json_str = generator.generate_single()
        parsed = json.loads(json_str)

        # 验证基本结构
        assert "name" in parsed
        assert "email" in parsed
        assert isinstance(parsed["name"], str)
        assert isinstance(parsed["email"], str)

    def test_json_batch_generation(self):
        """测试批量JSON生成"""
        config = GeneratorConfig(
            generator_type="json",
            parameters={"depth": 2}
        )
        generator = GenericJSONGenerator(config)

        batch = generator.generate_batch(5)
        assert len(batch) == 5

        for json_str in batch:
            assert generator.validate(json_str)
            parsed = json.loads(json_str)
            assert isinstance(parsed, dict)

    def test_nested_json_structure(self):
        """测试嵌套JSON结构"""
        config = GeneratorConfig(
            generator_type="json",
            parameters={
                "depth": 4,
                "array_size": (2, 4)
            }
        )
        generator = GenericJSONGenerator(config)

        json_str = generator.generate_single()
        parsed = json.loads(json_str)

        # 验证嵌套结构
        def check_depth(obj, current_depth=0):
            if isinstance(obj, dict):
                if current_depth >= 4:
                    return all(not isinstance(v, (dict, list)) for v in obj.values())
                return any(isinstance(v, (dict, list)) for v in obj.values())
            elif isinstance(obj, list):
                return any(isinstance(item, (dict, list)) for item in obj)
            return True

        assert check_depth(parsed)


class TestXMLGenerator:
    """XML生成器测试"""

    def test_basic_xml_generation(self):
        """测试基础XML生成"""
        config = GeneratorConfig(
            generator_type="xml",
            parameters={
                "root_name": "test",
                "depth": 2,
                "use_attributes": True
            }
        )
        generator = GenericXMLGenerator(config)

        xml_str = generator.generate_single()
        root = ET.fromstring(xml_str)

        assert root.tag == "test"
        assert generator.validate(xml_str)

    def test_xml_with_namespace(self):
        """测试带命名空间的XML"""
        import re

        config = GeneratorConfig(
            generator_type="xml",
            parameters={
                "root_name": "data",
                "use_namespace": True,
                "namespace": "http://example.com/schema"
            }
        )
        generator = GenericXMLGenerator(config)

        xml_str = generator.generate_single()

        # 使用正则表达式验证xmlns属性
        xmlns_pattern = r'xmlns="([^"]*)"'
        match = re.search(xmlns_pattern, xml_str)

        assert match is not None, "xmlns attribute not found"
        assert match.group(1) == "http://example.com/schema"

    def test_xml_with_attributes(self):
        """测试带属性的XML"""
        config = GeneratorConfig(
            generator_type="xml",
            parameters={
                "root_name": "user",
                "use_attributes": True,
                "depth": 1
            }
        )
        generator = GenericXMLGenerator(config)

        xml_str = generator.generate_single()
        root = ET.fromstring(xml_str)

        # 验证根元素或子元素有属性
        has_attributes = bool(root.attrib) or any(
            bool(child.attrib) for child in root
        )
        assert has_attributes

    def test_xml_batch_generation(self):
        """测试批量XML生成"""
        config = GeneratorConfig(
            generator_type="xml",
            parameters={"depth": 2}
        )
        generator = GenericXMLGenerator(config)

        batch = generator.generate_batch(3)
        assert len(batch) == 3

        for xml_str in batch:
            assert generator.validate(xml_str)
            root = ET.fromstring(xml_str)
            assert root is not None

    def test_xml_templates(self):
        """测试XML模板"""
        templates = ["user", "product", "config"]

        for template in templates:
            config = GeneratorConfig(
                generator_type="xml",
                parameters={"template": template, "depth": 2}
            )
            generator = GenericXMLGenerator(config)

            xml_str = generator.generate_single()
            root = ET.fromstring(xml_str)

            assert root.tag == template


