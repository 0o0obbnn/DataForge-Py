def test_parameterized_generators():
    """测试参数化生成器"""
    print("\n=== 参数化测试 ===")

    # 测试不同参数组合
    configs = [
        GeneratorConfig(
            generator_type="education",
            parameters={"system": "INTERNATIONAL", "format": "SCHOOL"},
        ),
        GeneratorConfig(
            generator_type="blood_type", parameters={"rh": True, "format": "FORMAL"}
        ),
        GeneratorConfig(
            generator_type="marital_status",
            parameters={"age_group": "YOUNG", "format": "ENGLISH"},
        ),
    ]

    generators = [
        EducationGenerator(configs[0]),
        BloodTypeGenerator(configs[1]),
        MaritalStatusGenerator(configs[2]),
    ]

    for i, gen in enumerate(generators):
        result = gen.generate_single()
        print(f"参数化测试 {i + 1}: {result}")
        assert gen.validate(result), f"验证失败: {result}"


def test_batch_generation():
    """测试批量生成"""
    print("\n=== 批量生成测试 ===")

    config = GeneratorConfig(
        generator_type="generic_occupation", parameters={"format": "simple"}
    )

    occupation_gen = GenericOccupationGenerator(config)
    results = occupation_gen.generate_batch(10)

    print(f"批量生成 {len(results)} 个职业:")
    for i, result in enumerate(results, 1):
        print(f"  {i}: {result}")
        assert occupation_gen.validate(result), f"验证失败: {result}"


def main():
    """主测试函数"""
    print("开始测试基础生成器...")

    try:
        test_occupation_generators()
        test_education_generators()
        test_extended_profile_generators()
        test_parameterized_generators()
        test_batch_generation()

        print("\n✅ 所有测试通过!")

    except Exception as e:
        print(f"\n❌ 测试失败: {e}")
        import traceback

        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
