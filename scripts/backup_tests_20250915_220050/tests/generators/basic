#!/usr/bin/env python3
"""
基础生成器测试脚本

测试occupation、education、extended_profile模块中的各种生成器
"""

import os
import sys

# 添加项目根目录到Python路径
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dataforge.core.generator import GeneratorConfig
from dataforge.generators.basic.education import (
    EducationGenerator,
    GenericEducationGenerator,
)
from dataforge.generators.basic.extended_profile import (
    BloodTypeGenerator,
    EthnicityGenerator,
    MaritalStatusGenerator,
    ZodiacGenerator,
)
from dataforge.generators.basic.occupation import (
    GenericOccupationGenerator,
    OccupationGenerator,
)


def test_occupation_generators():
    """测试职业生成器"""
    print("=== 职业生成器测试 ===")

    # 测试OccupationGenerator
    config1 = GeneratorConfig(
        generator_type="occupation", parameters={"format": "full", "industry": "tech"}
    )
    occupation_gen = OccupationGenerator(config1)

    for i in range(5):
        result = occupation_gen.generate_single()
        print(f"职业 {i + 1}: {result}")
        assert occupation_gen.validate(result), f"验证失败: {result}"

    # 测试GenericOccupationGenerator
    config2 = GeneratorConfig(
        generator_type="generic_occupation", parameters={"format": "simple"}
    )
    generic_gen = GenericOccupationGenerator(config2)

    for i in range(3):
        result = generic_gen.generate_single()
        print(f"通用职业 {i + 1}: {result}")
        assert generic_gen.validate(result), f"验证失败: {result}"


