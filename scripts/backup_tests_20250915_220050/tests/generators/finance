#!/usr/bin/env python3
"""
金融类生成器最终测试脚本
"""

import os
import sys

# 添加项目根目录到Python路径
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "."))

# 确保导入金融模块
from dataforge.core.factory import default_factory
from dataforge.core.generator import GenerationContext, GeneratorConfig


def test_finance_generators():
    """测试所有金融类生成器"""
    print("🚀 开始测试金融类生成器...\n")

    context = GenerationContext()

    # 测试股票代码生成器
    print("📈 股票代码生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="stock_code", parameters={"market": "china"}
        )
        stock_gen = default_factory.create_generator(config)
        print(f"A股代码: {stock_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="stock_code", parameters={"market": "hk"}
        )
        stock_gen = default_factory.create_generator(config)
        print(f"港股代码: {stock_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="stock_code", parameters={"market": "us"}
        )
        stock_gen = default_factory.create_generator(config)
        print(f"美股代码: {stock_gen.generate(context)}")
    except Exception as e:
        print(f"股票代码生成器错误: {e}")
    print()

    # 测试基金代码生成器
    print("💰 基金代码生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="fund_code", parameters={"type": "public", "region": "china"}
        )
        fund_gen = default_factory.create_generator(config)
        print(f"中国公募基金: {fund_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="fund_code",
            parameters={"type": "private", "region": "china"},
        )
        fund_gen = default_factory.create_generator(config)
        print(f"中国私募基金: {fund_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="fund_code", parameters={"region": "us"}
        )
        fund_gen = default_factory.create_generator(config)
        print(f"美国基金: {fund_gen.generate(context)}")
    except Exception as e:
        print(f"基金代码生成器错误: {e}")
    print()

    # 测试债券代码生成器
    print("📊 债券代码生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="bond_code",
            parameters={"type": "treasury", "region": "china"},
        )
        bond_gen = default_factory.create_generator(config)
        print(f"中国国债: {bond_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="bond_code",
            parameters={"type": "corporate", "region": "china"},
        )
        bond_gen = default_factory.create_generator(config)
        print(f"中国企业债: {bond_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="bond_code",
            parameters={"type": "convertible", "region": "china"},
        )
        bond_gen = default_factory.create_generator(config)
        print(f"中国可转债: {bond_gen.generate(context)}")
    except Exception as e:
        print(f"债券代码生成器错误: {e}")
    print()

    # 测试期货代码生成器
    print("⚖️ 期货代码生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="future_code",
            parameters={"type": "commodity", "region": "china"},
        )
        future_gen = default_factory.create_generator(config)
        print(f"中国商品期货: {future_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="future_code",
            parameters={"type": "financial", "region": "china"},
        )
        future_gen = default_factory.create_generator(config)
        print(f"中国金融期货: {future_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="future_code", parameters={"region": "us"}
        )
        future_gen = default_factory.create_generator(config)
        print(f"美国期货: {future_gen.generate(context)}")
    except Exception as e:
        print(f"期货代码生成器错误: {e}")
    print()

    # 测试银行账号生成器
    print("🏦 银行账号生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="bank_account",
            parameters={"bank": "icbc", "region": "china"},
        )
        bank_gen = default_factory.create_generator(config)
        print(f"工商银行账号: {bank_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="bank_account", parameters={"bank": "cmb", "region": "china"}
        )
        bank_gen = default_factory.create_generator(config)
        print(f"招商银行账号: {bank_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="bank_account", parameters={"region": "us"}
        )
        bank_gen = default_factory.create_generator(config)
        print(f"美国银行账号: {bank_gen.generate(context)}")
    except Exception as e:
        print(f"银行账号生成器错误: {e}")
    print()

    # 测试加密货币地址生成器
    print("₿ 加密货币地址生成器测试:")
    try:
        config = GeneratorConfig(
            generator_type="crypto_address", parameters={"currency": "bitcoin"}
        )
        crypto_gen = default_factory.create_generator(config)
        print(f"比特币地址: {crypto_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="crypto_address", parameters={"currency": "ethereum"}
        )
        crypto_gen = default_factory.create_generator(config)
        print(f"以太坊地址: {crypto_gen.generate(context)}")

        config = GeneratorConfig(
            generator_type="crypto_address", parameters={"currency": "litecoin"}
        )
        crypto_gen = default_factory.create_generator(config)
        print(f"莱特币地址: {crypto_gen.generate(context)}")
    except Exception as e:
        print(f"加密货币地址生成器错误: {e}")
    print()

    print("✅ 所有金融类生成器测试完成！")


if __name__ == "__main__":
    test_finance_generators()
