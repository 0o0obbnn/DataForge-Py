#!/usr/bin/env python3
"""
百分比生成器测试
"""

import os
import sys

# 添加项目根目录到Python路径
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from dataforge.core.factory import default_factory
from dataforge.core.generator import GeneratorConfig

# 确保numeric模块被导入以触发注册


def test_percentage_generator():
    """测试百分比生成器"""
    print("=== 测试百分比生成器 ===")

    # 测试基本百分比生成
    print("\n1. 基本百分比生成:")
    config = GeneratorConfig(generator_type="percentage", parameters={})
    generator = default_factory.create_generator(config)
    for i in range(5):
        result = generator.generate()
        print(f"  生成 {i + 1}: {result}")

    # 测试自定义范围
    print("\n2. 自定义范围 [10, 50]:")
    config = GeneratorConfig(
        generator_type="percentage", parameters={"min": 10, "max": 50}
    )
    generator = default_factory.create_generator(config)
    for i in range(5):
        result = generator.generate()
        print(f"  生成 {i + 1}: {result}")

    # 测试高精度
    print("\n3. 高精度 (4位小数):")
    config = GeneratorConfig(generator_type="percentage", parameters={"precision": 4})
    generator = default_factory.create_generator(config)
    for i in range(3):
        result = generator.generate()
        print(f"  生成 {i + 1}: {result}")

    # 测试不包含百分号
    print("\n4. 不包含百分号:")
    config = GeneratorConfig(
        generator_type="percentage", parameters={"include_percent_sign": False}
    )
    generator = default_factory.create_generator(config)
    for i in range(3):
        result = generator.generate()
        print(f"  生成 {i + 1}: {result}")

    # 测试归一化到[0,1]
    print("\n5. 归一化到[0,1]:")
    config = GeneratorConfig(
        generator_type="percentage", parameters={"normalized": True}
    )
    generator = default_factory.create_generator(config)
    for i in range(5):
        result = generator.generate()
        print(f"  生成 {i + 1}: {result}")

    # 测试批量生成
    print("\n6. 批量生成 (10个):")
    results = generator.generate_batch(10)
    for i, result in enumerate(results):
        print(f"  批量 {i + 1}: {result}")

    # 测试校验功能
    print("\n7. 校验功能测试:")
    valid_values = [25.5, 0.255, 99.9, 0.999]  # 正常值和归一化值
    invalid_values = [150.0, -5.0, 1.5, -0.1]  # 超出范围的值

    # 测试正常百分比
    config = GeneratorConfig(generator_type="percentage", parameters={})
    normal_generator = default_factory.create_generator(config)
    for value in valid_values[:2]:
        is_valid = normal_generator.validate(value)
        print(f"  值 {value}% 校验: {'通过' if is_valid else '失败'}")

    for value in invalid_values[:2]:
        is_valid = normal_generator.validate(value)
        print(f"  值 {value}% 校验: {'通过' if is_valid else '失败'}")

    # 测试归一化百分比
    config = GeneratorConfig(
        generator_type="percentage", parameters={"normalized": True}
    )
    normalized_generator = default_factory.create_generator(config)
    for value in valid_values[2:]:
        is_valid = normalized_generator.validate(value)
        print(f"  归一化值 {value} 校验: {'通过' if is_valid else '失败'}")

    for value in invalid_values[2:]:
        is_valid = normalized_generator.validate(value)
        print(f"  归一化值 {value} 校验: {'通过' if is_valid else '失败'}")


if __name__ == "__main__":
    test_percentage_generator()
