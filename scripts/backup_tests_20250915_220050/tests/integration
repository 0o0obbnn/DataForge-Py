"""
测试上下文感知生成器与工厂系统的集成
"""

import json

from dataforge.core.context import GenerationContext
from dataforge.core.factory import GeneratorConfig, default_factory
from dataforge.generators.basic.enhanced_generators import PersonDataGenerator


def test_factory_integration():
    """测试与工厂系统的集成"""
    print("=== 测试与工厂系统的集成 ===")

    # 使用默认工厂实例
    factory = default_factory

    # 创建上下文
    context = GenerationContext()

    # 使用工厂创建基础生成器
    name_config = GeneratorConfig(generator_type="name", parameters={})
    age_config = GeneratorConfig(generator_type="age", parameters={})

    name_gen = factory.create_generator(name_config)
    age_gen = factory.create_generator(age_config)

    # 生成数据并存储到上下文
    name = name_gen.generate(context)
    context.set("name", name, {"generator": "factory_name"})

    age = age_gen.generate(context)
    context.set("age", age, {"generator": "factory_age"})

    print(f"工厂生成姓名: {name}")
    print(f"工厂生成年龄: {age}")
    print(f"上下文数据: {json.dumps(context.snapshot(), indent=2, ensure_ascii=False)}")

    assert context.get("name") == name
    assert context.get("age") == age
    print("✓ 工厂集成测试通过\n")


def test_context_aware_factory():
    """测试上下文感知的工厂模式"""
    print("=== 测试上下文感知的工厂模式 ===")

    # 创建上下文
    context = GenerationContext()

    # 设置一些初始数据
    context.set("user_id", "U12345", {"type": "user"})
    context.set("session_id", "S67890", {"type": "session"})

    # 使用个人数据生成器（已集成上下文）
    person_gen = PersonDataGenerator(external_context=context)

    # 生成个人数据
    person_data = person_gen.generate_person()

    # 验证上下文包含初始数据
    context_snapshot = person_data["context"]

    print("生成的个人数据:")
    print(json.dumps(person_data["data"], indent=2, ensure_ascii=False))

    print("上下文元数据:")
    print(json.dumps(context_snapshot, indent=2, ensure_ascii=False))

    # 验证数据结构完整性
    assert "user_id" in context_snapshot["data"]
    assert "session_id" in context_snapshot["data"]
    assert "name" in context_snapshot["data"]
    assert "age" in context_snapshot["data"]

    print("✓ 上下文感知工厂模式测试通过\n")


def test_dependency_chain():
    """测试依赖链生成"""
    print("=== 测试依赖链生成 ===")

    context = GenerationContext()

    # 设置复杂的依赖关系
    context.add_dependency("email", "name")
    context.add_dependency("email", "age")  # 邮箱可能基于年龄和姓名
    context.add_dependency("phone", "region")
    context.add_dependency("id_card", "name")
    context.add_dependency("id_card", "age")
    context.add_dependency("id_card", "region")

    # 设置区域信息
    context.set("region", "Beijing", {"type": "location"})

    # 使用个人数据生成器
    person_gen = PersonDataGenerator()

    # 生成数据
    person_data = person_gen.generate_person()

    # 验证生成顺序
    order = person_data["generation_order"]

    print(f"生成顺序: {order}")
    print(f"依赖关系: {context.get_all_dependencies()}")

    # 验证基本字段都在生成顺序中
    required_fields = ["name", "age", "id_card", "phone", "email"]
    for field in required_fields:
        assert field in order, f"缺少字段 {field} 在生成顺序中"

    print("✓ 依赖链生成测试通过\n")


def test_batch_with_shared_context():
    """测试批量生成共享上下文"""
    print("=== 测试批量生成共享上下文 ===")

    # 创建共享上下文
    shared_context = GenerationContext()
    shared_context.set("company", "DataForge", {"type": "organization"})
    shared_context.set("department", "Engineering", {"type": "department"})

    # 创建多个生成器实例，共享上下文
    generators = []
    for _i in range(3):
        gen = PersonDataGenerator()
        # 注意：每个PersonDataGenerator有自己的上下文，需要手动同步
        generators.append(gen)

    # 批量生成
    first_gen = generators[0]
    batch_data = first_gen.generate_batch(3)

    print(f"批量生成 {len(batch_data)} 条记录")

    # 验证每条记录都有完整数据
    for i, record in enumerate(batch_data):
        print(f"记录 {i + 1}:")
        print(f"  姓名: {record['data']['name']}")
        print(f"  年龄: {record['data']['age']}")
        print(f"  身份证: {record['data']['id_card']}")

    assert len(batch_data) == 3
    assert all("name" in record["data"] for record in batch_data)
    assert all("age" in record["data"] for record in batch_data)

    print("✓ 批量生成测试通过\n")


def test_context_validation():
    """测试上下文验证功能"""
    print("=== 测试上下文验证功能 ===")

    context = GenerationContext()

    # 测试依赖验证
    context.add_dependency("email", "name")
    context.add_dependency("email", "age")

    # 测试正常依赖
    context.add_dependency("phone", "name")
    order = context.get_generation_order()

    print(f"验证后的生成顺序: {order}")

    # 应该包含所有必要的字段
    # 验证顺序合理性
    if "name" in order and "email" in order:
        name_idx = order.index("name")
        email_idx = order.index("email")
        assert name_idx < email_idx, "姓名应该在邮箱之前生成"

    print("✓ 上下文验证测试通过\n")


if __name__ == "__main__":
    try:
        test_factory_integration()
        test_context_aware_factory()
        test_dependency_chain()
        test_batch_with_shared_context()
        test_context_validation()

        print("🎉 所有集成测试通过！")

    except Exception as e:
        print(f"❌ 集成测试失败: {e}")
        import traceback

        traceback.print_exc()
